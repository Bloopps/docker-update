#!/usr/bin/env python3
"""Faux `docker` pour le test de bout en bout : état dans le fichier $SHIM_STATE."""
import hashlib, json, os, sys

path = os.environ["SHIM_STATE"]
W = json.load(open(path))
a = sys.argv[1:]

def save():
    json.dump(W, open(path, "w"))

def out(s):
    sys.stdout.write(s)

def die(msg, rc=1):
    sys.stderr.write(msg + "\n")
    sys.exit(rc)

W.setdefault("log", []).append(a)

if a[:1] == ["compose"]:
    ddir = a[a.index("--project-directory") + 1]
    sub = next(x for x in a[1:] if x in ("ps", "config", "up"))
    svc = a[-1]
    key = ddir + "|" + svc
    if sub == "ps":
        if key in W["containers"]:
            out(W["containers"][key]["id"] + "\n")
    elif sub == "config":
        out(json.dumps({"services": {s: {"image": r, "environment": {"T": "hunter2"}} for s, r in W["compose"][ddir].items()}}))
    else:
        for flag in ("-d", "--no-deps", "--wait"):
            assert flag in a, flag
        assert a[a.index("--pull") + 1] == "never"
        iid = W["tags"][W["compose"][ddir][svc]]
        if iid in W.get("fail_up", []):
            save(); die("service unhealthy")
        W["containers"][key].update(image_id=iid, status="running")
elif a[:1] == ["inspect"]:
    cid = a[-1]
    c = next(v for v in W["containers"].values() if v["id"] == cid)
    out((c["status"] + "|\n") if "State.Status" in a[2] else c["image_id"] + "\n")
elif a[:2] == ["image", "inspect"]:
    if "Config.Labels" in a[3]:
        iid = W["by"].get(a[-1], a[-1])
        out(json.dumps(W.get("labels", {}).get(iid, {})))
    else:
        out(json.dumps(W["images"].get(a[-1], [])))
elif a[:3] == ["buildx", "imagetools", "inspect"]:
    assert a[-1] == "--raw"
    sys.stdout.write(W["registry"][a[3]])
elif a[:1] == ["pull"]:
    repo, digest = a[1].split("@")
    iid = "id-" + digest[7:19]
    W["images"][iid] = [a[1]]
    W["by"][a[1]] = iid
    ver = W.get("digest_versions", {}).get(digest)
    if ver:
        W.setdefault("labels", {})[iid] = {"org.opencontainers.image.version": ver}
elif a[:2] == ["image", "rm"]:
    assert "-f" not in a and "--force" not in a, "le nettoyage ne force jamais"
    if any(c["image_id"] == a[2] for c in W["containers"].values()):
        save(); die("Error: conflict: unable to delete %s: image is being used by running container" % a[2])
    W.setdefault("removed", []).append(a[2])
elif a[:1] == ["tag"]:
    W["tags"][a[2]] = W["by"].get(a[1], a[1])
else:
    die("commande inattendue : %r" % (a,), 2)
save()
